[Unit]
Description=Private reverse tunnel from Korovany VDS to zetoqqq.ru
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=korovany-proxy
Group=korovany-proxy
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/korovany-tunnel/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -i /etc/korovany-tunnel/id_ed25519 -R 127.0.0.1:18090:127.0.0.1:8090 korovany-tunnel@89.110.93.237
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=64M

[Install]
WantedBy=multi-user.target
